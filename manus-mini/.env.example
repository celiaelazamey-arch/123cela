# Choose: gemini | groq | huggingface | nvidia
AI_PROVIDER=gemini

# Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq Free tier (model is pinned by the app to openai/gpt-oss-20b)
GROQ_API_KEY=

# Hugging Face Inference Providers (optional)
HF_TOKEN=
HF_MODEL=
HF_BASE_URL=https://router.huggingface.co/v1/chat/completions

# NVIDIA NIM (optional)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Protect a public deployment with a shared password.
# Also set a long random SESSION_SECRET before deploying.
APP_ACCESS_PASSWORD=
SESSION_SECRET=

# Optional: max requests per minute per IP for the chat route.
CHAT_RATE_LIMIT=12

# Optional persistent workspace storage (run supabase/schema.sql first).
# Keep the service-role key server-side; never use a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
